# Needed for the concierge chat. Never commit the real value.
ANTHROPIC_API_KEY=
# Optional: Neon Postgres (persistent). Without it the app uses data/concierge.db (SQLite).
DATABASE_URL=
# Optional: unlocks the Staff page (approve / decline, analytics, QR codes).
STAFF_PASSWORD=
# Optional (defaults in the README configuration table)
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=low
RETRIEVAL=hybrid
TOP_K=4
RESORT_TZ=America/New_York
MAX_QUESTIONS_PER_SESSION=25
RATE_LIMIT_PER_MINUTE=6
DAILY_QUESTION_CAP=400
DAILY_COST_CAP_USD=1.50
PRICE_IN_PER_M=0.10
PRICE_OUT_PER_M=0.50
APP_URL=
DEMO_VIDEO_URL=
